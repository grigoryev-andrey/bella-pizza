<script src="/js/crud.js"></script>

<div class="crud-page">
  <h1 class="crud-title">{{pageTitle}}</h1>
  <div class="crud-actions">
    <button class="crud-btn create-btn action-button" data-entity="create">Create</button>
    <button class="crud-btn update-btn action-button" data-entity="update">Update</button>
    <button class="crud-btn delete-btn action-button" data-entity="delete">Delete</button>
  </div>
</div>