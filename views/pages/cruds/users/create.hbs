<script src="/js/cruds/user.js"></script>

<div class="crud-container">
  <div id="crud-warning" class="crud-warning"></div>
  <div class="crud-static-warning">Это влечёт за собой рассинхронизацию с SuperTokens!</div>
  <h2 class="crud-title">Создать пользователя</h2>

  <form id="user-create" class="crud-form">
    <div class="crud-field">
      <label for="name" class="crud-label">Имя</label>
      <input type="text" id="name" name="name" class="crud-input" required>
    </div>

    <div class="crud-field">
      <label for="email" class="crud-label">Электронная почта</label>
      <input type="text" id="email" name="email" class="crud-input" required>
    </div>

    <div class="crud-buttons">
      <button type="button" id="createBtn" class="crud-button">Создать</button>
    </div>
  </form>

  <div id="after-action" class="after-action" style="display:none;">
    <button id="viewBtn" class="crud-button">Посмотреть изменения</button>
  </div>
</div>
