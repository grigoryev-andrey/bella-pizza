<script src="/js/cruds/testimonial.js"></script>

<div class="crud-container">
  <div id="crud-warning" class="crud-warning"></div>

  <h2 class="crud-title">Обновить отзыв</h2>

  <form id="testimonial-update" class="crud-form">
    <div class="crud-field">
      <label for="updateId" class="crud-label">ID отзыва</label>
      <input type="text" id="updateId" name="updateId" class="crud-input" required>
    </div>

    <div class="crud-field">
      <label for="message" class="crud-label">Сообщение</label>
      <textarea id="message" name="message" class="crud-input" rows="4"></textarea>
    </div>

    <div class="crud-field">
      <label for="rating" class="crud-label">Рейтинг (1–5)</label>
      <input type="number" id="rating" name="rating" class="crud-input" min="1" max="5">
    </div>

    <div class="crud-field">
      <label for="userId" class="crud-label">ID пользователя</label>
      <input type="text" id="userId" name="userId" class="crud-input">
    </div>

    <div class="crud-buttons">
      <button type="button" id="updateBtn" class="crud-button">Обновить</button>
    </div>
  </form>

  <div id="after-action" class="after-action" style="display:none;">
    <button id="viewBtn" class="crud-button">Посмотреть изменения</button>
  </div>
</div>
