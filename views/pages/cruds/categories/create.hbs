<script src="/js/cruds/category.js"></script>

<div class="crud-container">
  <div id="crud-warning" class="crud-warning"></div>

  <h2 class="crud-title">Создать категорию</h2>

  <form id="category-create" class="crud-form">
    <div class="crud-field">
      <label for="name" class="crud-label">Название</label>
      <input type="text" id="name" name="name" class="crud-input" required>
    </div>

    <div class="crud-buttons">
      <button type="button" id="createCategoryBtn" class="crud-button">Создать</button>
    </div>
  </form>

  <div id="after-action" class="after-action" style="display:none;">
    <button id="viewBtn" class="crud-button">Посмотреть изменения</button>
  </div>
</div>

